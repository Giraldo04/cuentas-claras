      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:income|expense|savings|debt|ant|neutral)$/]",
        "message": "<StatCard> tone must be one of 'income' | 'expense' | 'savings' | 'debt' | 'ant' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Member'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|color|isChild|key|ref|className|style|children)$/]",
        "message": "<Member> doesn't accept that prop. Declared props: id, name, color, isChild."
      }
    ]
  },
